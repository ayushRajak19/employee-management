{
  "name": "@mobiusbloom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/jobs/seedSuperAdmin.ts",
    "seed:demo": "tsx src/jobs/seedDemoData.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@mobiusbloom/shared": "file:../shared", "bcrypt": "^6.0.0", "compression": "^1.8.0",
    "cookie-parser": "^1.4.7", "cors": "^2.8.5", "dotenv": "^17.2.0", "express": "^4.21.2",
    "express-rate-limit": "^7.5.1", "helmet": "^8.1.0", "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.4", "zod": "^3.25.76", "cloudinary": "^2.7.0", "multer": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0", "@types/bcrypt": "^6.0.0", "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.9", "@types/cors": "^2.8.19", "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10", "@types/node": "^24.0.14", "@types/multer": "^2.0.0", "eslint": "^9.31.0",
    "tsx": "^4.20.3", "typescript": "^5.8.3", "typescript-eslint": "^8.37.0"
  }
}
